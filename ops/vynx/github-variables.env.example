# Proposed destinations, NOT evidence that DNS/services have been provisioned.
# Set repository/environment variables only after DNS, TLS and endpoint verification.
VYNXDESK_SERVICE_API=https://desk-api.vynx.com.tr
VYNXDESK_RENDEZVOUS_SERVER=desk-relay.vynx.com.tr
# REQUIRED: matching relay PUBLIC key, not a private key, and real APK signer digest.
VYNXDESK_RENDEZVOUS_PUB_KEY=
VYNXDESK_ANDROID_CERT_SHA256=
